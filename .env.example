# PayPal Sandbox credentials (get from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to "true" to simulate PayPal API without credentials (for demo/testing)
PAYPAL_MOCK=false

# Optional: OpenAI API key — enables LLM-based parsing instead of the built-in NLP parser
OPENAI_API_KEY=

# Server port
PORT=3000
